# ---------------------------------------------------------------------------
# SMART CRM AI — environment. Copy to .env.local for local development.
# Never commit real secrets.
# ---------------------------------------------------------------------------
APP_ENV=development                      # development | test | staging | production
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Postgres. Locally: plain PG16 + supabase/local stub. Supabase: use the
# transaction pooler URL (port 6543) with the postgres user.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/smart_crm_dev
DATABASE_POOL_MAX=10

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Auth: local (dev/CI only) | supabase (staging/production)
AUTH_PROVIDER=local
# Sign-ups per client IP per hour (abuse protection)
AUTH_SIGNUP_LIMIT_PER_HOUR=10
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# File storage: local (dev) | supabase
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
SUPABASE_STORAGE_BUCKET=crm-files

# Email: log (dev mailbox at /dev/mailbox, nothing is sent) | resend
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="SMART CRM AI <no-reply@example.com>"

# AI: mock (deterministic, no network) | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_PRICE_INPUT_PER_1M=0.25
OPENAI_PRICE_OUTPUT_PER_1M=2

# WhatsApp: mock (never contacts Meta) | meta (official Cloud API)
WHATSAPP_PROVIDER=mock
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Billing: mock | stripe. Live charging additionally needs BILLING_LIVE_MODE=true.
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_LIVE_MODE=false
