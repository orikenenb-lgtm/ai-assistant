{
  "name": "smart-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:reset": "tsx scripts/db.ts reset",
    "db:status": "tsx scripts/db.ts status",
    "db:generate": "tsx scripts/gen-schema.ts",
    "db:check": "tsx scripts/gen-schema.ts --check",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx src/worker/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
