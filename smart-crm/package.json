    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "^12.12.0",
    "bidi-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
