    "next-themes": "^0.4.6",
    "openai": "^7.39.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
