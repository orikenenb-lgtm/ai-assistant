# JARVIS Desktop — דוגמת משתני סביבה (לפיתוח בלבד)
# =================================================
# באפליקציה עצמה מזינים מפתחות במסך ההגדרות, והם נשמרים מוצפנים
# ב-Windows DPAPI (Electron safeStorage). אין צורך בקובץ הזה בשימוש רגיל.
# אם תעתיק לקובץ .env — הוא חסום ב-.gitignore. לעולם אל תעלה מפתחות ל-Git.

# Claude (Anthropic) — המוח: הבנת בקשות, tool calling וניתוח צילומי מסך
ANTHROPIC_API_KEY=

# OpenAI — תמלול (gpt-4o-transcribe) ו/או קול (gpt-4o-mini-tts), לפי הבחירה בהגדרות
OPENAI_API_KEY=

# Azure AI Speech — קול עברי טבעי (he-IL) ו/או תמלול
AZURE_SPEECH_KEY=

# Picovoice — רק אם בוחרים Porcupine כמנוע מילת ההפעלה
PICOVOICE_ACCESS_KEY=
