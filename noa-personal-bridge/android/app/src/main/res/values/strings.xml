    <string name="sending_dialog_point_unverified">השליחה עדיין לא אומתה על המכשיר הזה ועלולה לא לעבוד.</string>
    <string name="sending_dialog_point_approval">כל הודעה עדיין דורשת אישור מפורש שלך. אין שליחה אוטומטית.</string>
    <string name="sending_dialog_point_delivery">אי אפשר לאשר מסירה: גם אחרי העברה ל-WhatsApp לא ידוע בוודאות שההודעה נשלחה.</string>
    <string name="sending_dialog_point_once">כל טיוטה נשלחת לכל היותר פעם אחת, ולא ננסה שוב אוטומטית.</string>
