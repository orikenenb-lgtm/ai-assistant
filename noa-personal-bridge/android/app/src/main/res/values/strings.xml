    <string name="consent_dialog_what_body">הטקסט של ההודעות הנכנסות החדשות משיחות פרטיות בלבד, ושם התצוגה של השולח. לא נשלחים מספרי טלפון, הודעות מקבוצות, היסטוריית שיחות מלאה, תמונות או קבצים.</string>
    <string name="consent_dialog_where_title">לאן זה נשלח</string>
    <string name="consent_dialog_where_body">לשרת הגשר שאליו חיברת את המכשיר, ומשם למודל הבינה המלאכותית שמנסח את הטיוטה.</string>
    <string name="consent_dialog_control_title">השליטה אצלך</string>
    <string name="consent_dialog_control_body">בלי הסכמה לא נשלח כלום. אפשר לבטל את ההסכמה בכל רגע בהגדרות, ושיחות ספציפיות אפשר להחריג.</string>
