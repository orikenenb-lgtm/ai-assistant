# NOA Personal Bridge — bridge-service configuration (all variables use the BRIDGE_ prefix).
# The service does NOT read .env automatically: export these (e.g. `set -a; . ./.env; set +a`)
# or pass them with `docker run --env-file .env`. Never commit a real .env.

# --- feature flag / kill switch ---------------------------------------------------------
# false → /v1/pair and /v1/drafts return 503 "disabled"
BRIDGE_ENABLED=false
# optional path; if the file exists the service acts disabled
BRIDGE_KILL_SWITCH_FILE=

# --- storage ----------------------------------------------------------------------------
# devices + pairing codes only (hashes); no message content
BRIDGE_DB_PATH=data/bridge.sqlite3

# --- AI engine --------------------------------------------------------------------------
# stub | anthropic | noa_persona
BRIDGE_ENGINE=stub
# secret — only for engine=anthropic / noa_persona
BRIDGE_ANTHROPIC_API_KEY=
BRIDGE_ANTHROPIC_MODEL=claude-haiku-5-5
BRIDGE_NOA_ENGINE_URL=
# secret
BRIDGE_NOA_ENGINE_API_KEY=
BRIDGE_NOA_AGENT_ID=
BRIDGE_OWNER_DISPLAY_NAME=
# hard upper bound per draft → 502 engine_error
BRIDGE_ENGINE_TIMEOUT_SECONDS=25
BRIDGE_MAX_CONCURRENT_DRAFTS=8

# --- abuse limits -----------------------------------------------------------------------
# per device
BRIDGE_RATE_LIMIT_PER_MINUTE=30
# per device
BRIDGE_RATE_LIMIT_PER_DAY=300
# per client IP
BRIDGE_PAIRING_ATTEMPTS_PER_HOUR=10
BRIDGE_PAIRING_CODE_TTL_MINUTES=10
# X-Bridge-Timestamp must be within ±this
BRIDGE_REPLAY_WINDOW_SECONDS=300
BRIDGE_IDEMPOTENCY_TTL_SECONDS=600
BRIDGE_MAX_BODY_BYTES=65536
# cap for each in-memory store
BRIDGE_MEMORY_MAX_ENTRIES=50000

# --- HTTP -------------------------------------------------------------------------------
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# true only behind your own reverse proxy (uses last X-Forwarded-For hop)
BRIDGE_TRUST_PROXY_HEADERS=false
# true exposes /docs and /openapi.json (local debugging only)
BRIDGE_DEBUG_DOCS=false
# uvicorn access log (paths only); our own request log is always on
BRIDGE_ACCESS_LOG=false
BRIDGE_LOG_LEVEL=INFO
