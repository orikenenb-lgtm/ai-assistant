# ===== אתר SMART Voice — משתני סביבה =====
# העתיקו ל-.env.local (פיתוח) או הגדירו ב-Vercel → Settings → Environment Variables.
# כל משתנה כאן אופציונלי: מה שלא מוגדר פשוט לא מוצג באתר (אין כפתורים מתים).

# --- כתובת האתר (לקישורים, sitemap ותמונת שיתוף) ---
NEXT_PUBLIC_SITE_URL=https://www.example.co.il

# --- ערוצי קשר שמוצגים באתר ---
# וואטסאפ בפורמט בינלאומי, ספרות בלבד (972 במקום 0). מפעיל כפתורי וואטסאפ.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# מספר טלפון שמגיע לסוכנת החיה, למשל 03-1234567. מפעיל ״התקשרו אליה״.
NEXT_PUBLIC_DEMO_PHONE=
# מייל ליצירת קשר (מוצג בפוטר, בפרטיות ובהצהרת הנגישות).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- לאן נשלחים לידים (צריך לפחות אחד בפרודקשן, אחרת הטופס מחזיר שגיאה ולא מאבד לידים) ---
# 1) Webhook: Make / Zapier / n8n / פלטפורמת הסוכן הקולי. נשלח JSON עם חתימת HMAC בכותרת X-Signature.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# 2) מייל לכל ליד דרך Resend (https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM="SMART Voice <leads@your-domain.co.il>"
# 3) SMART CRM AI: יוצר איש קשר (שלב ליד) ומשימת חזרה. מפתח עם הרשאות contacts:write + tasks:write.
SMART_CRM_API_URL=https://crm.your-domain.co.il/api/v1
SMART_CRM_API_KEY=

# כמה לידים (טופס + דמו יחד) מותר לכתובת IP אחת לשעה. ברירת מחדל 6.
LEAD_RATE_LIMIT_PER_HOUR=

# --- הסוכנת בדמו החי ---
# בלי מפתח: מנוע שיחה מובנה (חינם, בלי עלות לשיחה). עם מפתח: Claude עונה באופן חופשי.
ANTHROPIC_API_KEY=
# ברירת מחדל claude-opus-5-5. לחיסכון אפשר claude-haiku-5-5.
AGENT_MODEL=
# rules = לכפות את המנוע המובנה גם כשיש מפתח
AGENT_MODE=
