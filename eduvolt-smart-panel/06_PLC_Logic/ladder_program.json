{
  "meta": {
    "project": "SMART THREE-PHASE ELECTRICAL PANEL",
    "controller": "Schneider Zelio Logic SR3B261BD",
    "language": "Ladder (Zelio Soft 2 notation)",
    "version": "v0.1",
    "date": "2026-10-15",
    "notation": {
      "contact_NO": "Uppercase first letter, e.g. I4, M5, T1, Q1",
      "contact_NC": "Lowercase first letter, e.g. i4, m5, t1 (inverted contact)",
      "coil_direct": "[X  (contactor coil)",
      "coil_set": "SX  (latch / set)",
      "coil_reset": "RX  (unlatch / reset)",
      "timer_trigger": "TTn (timer command coil)"
    },
    "rung_form": "Each rung = parallel branches (OR); each branch = series contacts (AND), max 5 per branch; one coil per rung.",
    "status": "DESIGN — verified only in the Python simulation in 07_Simulation. Must be re-verified in Zelio Soft 2 simulation mode."
  },
  "symbols": {
    "I1": {"name": "START", "comment": "לחצן START (NO)"},
    "I2": {"name": "STOP_OK", "comment": "לחצן STOP (NC) — 1 = משוחרר ותקין"},
    "I3": {"name": "RESET", "comment": "לחצן RESET (NO)"},
    "I4": {"name": "ESTOP_OK", "comment": "חירום משוחרר (בלוק NC שני)"},
    "I5": {"name": "OL_TRIPPED", "comment": "ממסר עומס יתר הופעל (97-98)"},
    "I6": {"name": "KM1_FB", "comment": "משוב KM1 (13-14)"},
    "I7": {"name": "TS1_WARN", "comment": "אזור A — סף אזהרה"},
    "I8": {"name": "TS2_ALARM", "comment": "אזור A — סף התראה"},
    "I9": {"name": "TS3_WARN", "comment": "אזור B — סף אזהרה"},
    "IA": {"name": "TS4_ALARM", "comment": "אזור B — סף התראה"},
    "IB": {"name": "SMOKE", "comment": "גלאי עשן במצב התראה"},
    "IC": {"name": "GAS", "comment": "MQ-2 דרך ממסר 5V"},
    "Q1": {"name": "KM1_CMD", "comment": "פקודת מגען מנוע"},
    "Q2": {"name": "KM2_CMD", "comment": "פקודת מגען הזנה"},
    "Q3": {"name": "LAMP_GREEN", "comment": "מנוע פועל"},
    "Q4": {"name": "LAMP_WHITE", "comment": "מוכן / מהבהב בחימום"},
    "Q5": {"name": "LAMP_YELLOW", "comment": "אזהרת טמפרטורה"},
    "Q6": {"name": "LAMP_AMBER", "comment": "נדרש איפוס"},
    "Q7": {"name": "LAMP_RED", "comment": "סכנה / חירום"},
    "Q8": {"name": "BUZZER", "comment": "זמזם"},
    "Q9": {"name": "SMOKE_RESET", "comment": "פולס ניתוק מתח לגלאי עשן (מותנה)"},
    "M1": {"name": "RST_EDGE", "comment": "פולס סריקה אחת בלחיצת RESET"},
    "M2": {"name": "RST_PREV", "comment": "מצב RESET בסריקה הקודמת"},
    "M3": {"name": "START_EDGE", "comment": "פולס סריקה אחת בלחיצת START"},
    "M4": {"name": "START_PREV", "comment": "מצב START בסריקה הקודמת"},
    "M5": {"name": "HAZ_ACTIVE", "comment": "סכנה פעילה (טמפ' גבוהה/עשן/גז). לוגיקה חיובית: ברירת המחדל 0 בעליית מתח = אין תקלה מדומה"},
    "M6": {"name": "GAS_EFF", "comment": "גז פעיל אחרי זמן חימום"},
    "M7": {"name": "MOT_FAULT", "comment": "תקלת מעגל מנוע (עומס יתר / משוב). לוגיקה חיובית"},
    "M8": {"name": "L_ESTOP", "comment": "נעילת תקלה — חירום"},
    "M9": {"name": "L_HAZ", "comment": "נעילת תקלה — סכנה"},
    "MA": {"name": "L_MOT", "comment": "נעילת תקלה — מעגל מנוע"},
    "MB": {"name": "ARMED", "comment": "המערכת אותחלה באיפוס מבוקר אחרי עליית מתח"},
    "MC": {"name": "ALL_CLEAR", "comment": "אין אף סיבת תקלה פעילה"},
    "MD": {"name": "RUN", "comment": "פקודת ריצה למנוע (נעילה עצמית)"},
    "ME": {"name": "BUZ", "comment": "זמזם — תקלה חדשה שטרם אושרה"},
    "MF": {"name": "SRST_REQ", "comment": "רצף איפוס גלאי עשן פעיל"},
    "MG": {"name": "NO_LATCH", "comment": "אין תקלה נעולה"},
    "MH": {"name": "WARN_NONE", "comment": "אין אזהרת טמפרטורה"},
    "MJ": {"name": "READY", "comment": "מוכן להפעלה (בלי בדיקת אזהרה)"},
    "MK": {"name": "ALWAYS_OFF", "comment": "לא מופעל לעולם — המגע ההפוך mK משמש כ'תמיד 1'"}
  },
  "timers": {
    "T1": {"name": "WARMUP", "type": "A", "preset_s": 30.0, "preset_status": "PLACEHOLDER_FOR_SIMULATION — real value TBD from MQ-2 datasheet and smoke detector manual", "comment": "זמן חימום אחרי עליית מתח"},
    "T2": {"name": "FB_FAIL_CLOSE", "type": "A", "preset_s": 1.0, "preset_status": "PLACEHOLDER — TBD", "comment": "פקודה בלי משוב = מגען לא נסגר"},
    "T3": {"name": "FB_WELDED", "type": "A", "preset_s": 1.0, "preset_status": "PLACEHOLDER — TBD", "comment": "משוב בלי פקודה = מגע מרותך"},
    "T4": {"name": "BLINK_ON", "type": "A", "preset_s": 0.5, "preset_status": "DESIGN_CHOICE", "comment": "מתנד הבהוב — חצי ראשון"},
    "T5": {"name": "BLINK_OFF", "type": "A", "preset_s": 0.5, "preset_status": "DESIGN_CHOICE", "comment": "מתנד הבהוב — חצי שני"},
    "T6": {"name": "SRST_PULSE", "type": "A", "preset_s": 3.0, "preset_status": "PLACEHOLDER — TBD from smoke detector manual", "comment": "משך ניתוק המתח לגלאי"},
    "T7": {"name": "SRST_SETTLE", "type": "A", "preset_s": 15.0, "preset_status": "PLACEHOLDER — TBD from smoke detector manual; must be > T6", "comment": "ניתוק + זמן התייצבות הגלאי"}
  },
  "rungs": [
    {"n": 1,  "branches": [["I3", "m2"]], "coil": "[M1", "comment": "זיהוי עלייה של RESET"},
    {"n": 2,  "branches": [["I3"]], "coil": "[M2", "comment": "שמירת מצב RESET לסריקה הבאה"},
    {"n": 3,  "branches": [["I1", "m4"]], "coil": "[M3", "comment": "זיהוי עלייה של START"},
    {"n": 4,  "branches": [["I1"]], "coil": "[M4", "comment": "שמירת מצב START לסריקה הבאה"},
    {"n": 5,  "branches": [["mK"]], "coil": "TT1", "comment": "טיימר חימום רץ מרגע עליית המתח"},
    {"n": 6,  "branches": [["IC", "T1"]], "coil": "[M6", "comment": "התראת גז נלקחת בחשבון רק אחרי החימום"},
    {"n": 7,  "branches": [["I8"], ["IA"], ["IB"], ["M6"]], "coil": "[M5", "comment": "סכנה: TS2 או TS4 או עשן או גז"},
    {"n": 8,  "branches": [["i7", "i9"]], "coil": "[MH", "comment": "אין אזהרת טמפרטורה"},
    {"n": 9,  "branches": [["MD", "i6"]], "coil": "TT2", "comment": "יש פקודה ואין משוב"},
    {"n": 10, "branches": [["mD", "I6"]], "coil": "TT3", "comment": "אין פקודה ויש משוב"},
    {"n": 11, "branches": [["I5"], ["T2"], ["T3"]], "coil": "[M7", "comment": "תקלת מנוע: עומס יתר או משוב שגוי"},
    {"n": 12, "branches": [["i4", "m8"], ["M5", "m9"], ["M7", "mA"]], "coil": "SME", "comment": "תקלה חדשה מפעילה את הזמזם"},
    {"n": 13, "branches": [["i4"]], "coil": "SM8", "comment": "נעילת חירום"},
    {"n": 14, "branches": [["M5"]], "coil": "SM9", "comment": "נעילת סכנה"},
    {"n": 15, "branches": [["M7"]], "coil": "SMA", "comment": "נעילת תקלת מנוע"},
    {"n": 16, "branches": [["M1", "IB", "mF"]], "coil": "SMF", "comment": "RESET כשהגלאי עדיין מתריע: התחלת רצף איפוס הגלאי"},
    {"n": 17, "branches": [["MF"]], "coil": "TT6", "comment": "משך ניתוק המתח לגלאי"},
    {"n": 18, "branches": [["MF"]], "coil": "TT7", "comment": "ניתוק + התייצבות"},
    {"n": 19, "branches": [["MF", "t6"]], "coil": "[Q9", "comment": "פולס ל-KA1 (המגע NC שלו מנתק את הגלאי)"},
    {"n": 20, "branches": [["T7"]], "coil": "RMF", "comment": "סיום רצף איפוס הגלאי"},
    {"n": 21, "branches": [["I4", "m5", "m7", "mF"]], "coil": "[MC", "comment": "אין אף סיבת תקלה פעילה"},
    {"n": 22, "branches": [["M1", "I4"]], "coil": "RM8", "comment": "שחרור נעילת חירום — רק אם החירום שוחרר"},
    {"n": 23, "branches": [["M1", "m5", "mF"]], "coil": "RM9", "comment": "שחרור נעילת סכנה — רק אם הסכנה חלפה"},
    {"n": 24, "branches": [["M1", "m7"]], "coil": "RMA", "comment": "שחרור נעילת מנוע — רק אם התקלה חלפה"},
    {"n": 25, "branches": [["M1"]], "coil": "RME", "comment": "RESET מאשר ומשתיק את הזמזם"},
    {"n": 26, "branches": [["M1", "T1", "MC"]], "coil": "SMB", "comment": "אתחול המערכת: רק באיפוס מבוקר אחרי החימום"},
    {"n": 27, "branches": [["m8", "m9", "mA"]], "coil": "[MG", "comment": "אין תקלה נעולה"},
    {"n": 28, "branches": [["MB", "MG", "MC", "I2"]], "coil": "[MJ", "comment": "מוכן: מאותחל, בלי נעילות, בלי תקלות, STOP תקין"},
    {"n": 29, "branches": [["M3", "MJ", "MH", "m1"]], "coil": "SMD", "comment": "הפעלה: עלייה של START, מוכן, בלי אזהרה, לא בסריקת RESET"},
    {"n": 30, "branches": [["mJ"]], "coil": "RMD", "comment": "עצירה: STOP, תקלה, נעילה או חוסר אתחול (עדיפות לעצירה)"},
    {"n": 31, "branches": [["MD"]], "coil": "[Q1", "comment": "פקודת KM1 (עוברת בחיווט קשיח דרך S0 ו-F4)"},
    {"n": 32, "branches": [["MB", "m8", "m9", "I4", "m5"]], "coil": "[Q2", "comment": "KM2 מוזן רק כשאין סכנה וחירום"},
    {"n": 33, "branches": [["Q1", "I6"]], "coil": "[Q3", "comment": "ירוק: פקודה + משוב"},
    {"n": 34, "branches": [["t5"]], "coil": "TT4", "comment": "מתנד הבהוב"},
    {"n": 35, "branches": [["T4"]], "coil": "TT5", "comment": "מתנד הבהוב"},
    {"n": 36, "branches": [["MJ"], ["t1", "T4"]], "coil": "[Q4", "comment": "לבן: מוכן, או מהבהב בזמן חימום"},
    {"n": 37, "branches": [["I7"], ["I9"]], "coil": "[Q5", "comment": "צהוב: אזהרת טמפרטורה"},
    {"n": 38, "branches": [["M8"], ["M9"], ["MA"], ["mB", "T1"]], "coil": "[Q6", "comment": "ענבר: תקלה נעולה או ממתין לאיפוס ראשון"},
    {"n": 39, "branches": [["M5"], ["i4"]], "coil": "[Q7", "comment": "אדום: סכנה פעילה או חירום לחוץ"},
    {"n": 40, "branches": [["ME"]], "coil": "[Q8", "comment": "זמזם"}
  ]
}
