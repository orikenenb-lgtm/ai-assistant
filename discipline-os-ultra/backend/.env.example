# DISCIPLINE OS ULTRA — coach-stream Edge Function environment (PLACEHOLDERS ONLY).
# Never commit a real value. In production set these with:
#   supabase secrets set --env-file ./backend/.env      (the real .env is git-ignored)
# For local `supabase functions serve --env-file backend/.env`.

# Model provider key — the ONLY secret. Lives only in the function environment, never in the app/APK.
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# Optional tuning (defaults shown).
COACH_MODEL=claude-sonnet-5-5
COACH_MAX_TOKENS=1500
COACH_EFFORT=low
COACH_REFUSAL_FALLBACK=on
COACH_DAILY_LIMIT=30
COACH_BURST_LIMIT=5
COACH_BURST_WINDOW_SECONDS=60

# Provided automatically by the Supabase runtime — do NOT set them yourself:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
