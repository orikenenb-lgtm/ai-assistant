{
  "name": "@ori/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ori Travel AI — Hebrew-first RTL family travel web app",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
