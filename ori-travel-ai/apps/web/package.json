    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "react-router": "8.5.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.6.7"
