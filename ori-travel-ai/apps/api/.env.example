# Ori Travel AI — API configuration example.
# Copy to apps/api/.env (git-ignored) and fill in values. NEVER commit real secrets.
# scripts/setup.ps1 creates .env automatically and generates ORI_DATA_KEY.

# ---- general ----
ORI_ENV=development
# Default: SQLite file in apps/api/data/ori_travel.db
# ORI_DATABASE_URL=sqlite:///C:/path/to/ori_travel.db
# PostgreSQL (optional; requires `pip install "psycopg[binary]"`):
# ORI_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ori_travel
ORI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORI_SERVE_WEB=true
# Set to true when served over HTTPS
ORI_COOKIE_SECURE=false

# ---- encryption of traveler documents (REQUIRED to store passport/DOB) ----
# Generate: python -m app.cli gen-key
ORI_DATA_KEY=

# ---- live travel providers (all optional; absent => "לא מחובר") ----
# Live providers are used ONLY when this flag is true AND credentials exist.
ORI_LIVE_PROVIDERS_ENABLED=false
# Official ECB reference FX rates for display-only conversions (free, opt-in)
ORI_FX_LIVE_ENABLED=false
ORI_DUFFEL_ACCESS_TOKEN=
ORI_AMADEUS_CLIENT_ID=
ORI_AMADEUS_CLIENT_SECRET=
ORI_AMADEUS_ENV=test
ORI_BOOKING_DEMAND_API_KEY=
ORI_BOOKING_DEMAND_AFFILIATE_ID=
ORI_EXPEDIA_RAPID_API_KEY=
ORI_EXPEDIA_RAPID_SHARED_SECRET=
ORI_VIATOR_API_KEY=
ORI_PROVIDER_TIMEOUT_SECONDS=12
ORI_PROVIDER_MAX_CONCURRENCY=4
ORI_SEARCH_CACHE_TTL_MINUTES=15

# ---- AI assistant (optional; manual search works without it) ----
# none | ollama (local, free) | anthropic (cloud, PAID — needs ORI_AI_ALLOW_PAID=true)
ORI_AI_PROVIDER=none
ORI_OLLAMA_BASE_URL=http://127.0.0.1:11434
ORI_OLLAMA_MODEL=qwen2.5:7b-instruct
ORI_ANTHROPIC_API_KEY=
ORI_ANTHROPIC_MODEL=claude-sonnet-5-5
# Explicit cost authorization for paid cloud LLM calls
ORI_AI_ALLOW_PAID=false
# Anthropic server-side refusal fallback bills an additional model — separate opt-in
ORI_AI_ANTHROPIC_SERVER_FALLBACK=false

# ---- price monitoring scheduler (opt-in; also enable it in the app settings) ----
ORI_SCHEDULER_ALLOWED=false
ORI_SCHEDULER_TICK_SECONDS=300
ORI_ALERT_MIN_INTERVAL_MINUTES=360
ORI_ALERT_MAX_CHECKS_PER_TICK=5

# ---- booking safety ----
# Real booking execution is NOT implemented in V1; the service refuses it regardless.
ORI_BOOKING_LIVE_EXECUTION=false
ORI_APPROVAL_TTL_MINUTES=30
