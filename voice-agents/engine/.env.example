# Public https URL of this engine (Twilio must reach it). No trailing slash.
PUBLIC_BASE_URL=https://engine.example.com
# Protects the engine REST API. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number calls are placed from (E.164)
TWILIO_PHONE_NUMBER=+972...
TWILIO_VALIDATE_SIGNATURE=true

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

AGENTS_DIR=agents
CALLS_DIR=data/calls

# Morning / Green Invoice API keys (Settings -> Developers). Keep sandbox on until tested.
MORNING_API_KEY_ID=
MORNING_API_KEY_SECRET=
MORNING_SANDBOX=true

# Comma separated numbers the engine must never dial
BLOCKED_NUMBERS=
